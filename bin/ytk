#!/usr/bin/env bash
# ytk — launcher for the youtube-knowledge toolkit.
#
# Works both as a manually-installed skill and as an installed Claude Code plugin.
# Resolves its own location (following symlinks), so the package travels with it.
# The Python virtualenv lives OUTSIDE the skill folder (in a stable cache dir) so
# it survives plugin updates, which replace the cached plugin directory.
#
# Requires python3 and ffmpeg on the system.
# Overrides: YTK_VENV (venv path), YTK_HOME (where harvested data is written).
set -euo pipefail

# Absolute path to the skill directory (parent of bin/), following symlinks.
SRC="${BASH_SOURCE[0]}"
while [ -h "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ "$SRC" != /* ]] && SRC="$DIR/$SRC"
done
HERE="$(cd -P "$(dirname "$SRC")/.." && pwd)"

# Stable venv location outside the (possibly cached/replaced) plugin directory.
VENV="${YTK_VENV:-${XDG_CACHE_HOME:-$HOME/.cache}/ytk/venv}"
PY="$VENV/bin/python"

if [ ! -x "$PY" ] || ! "$PY" -c "import yt_dlp" >/dev/null 2>&1; then
  echo "ytk: first-run setup — creating virtualenv and installing yt-dlp..." >&2
  mkdir -p "$(dirname "$VENV")"
  python3 -m venv "$VENV" >&2
  "$VENV/bin/pip" install --quiet --upgrade pip yt-dlp >&2
fi

# PYTHONPATH=$HERE so `python -m ytk` finds the package regardless of cwd.
exec env PYTHONPATH="$HERE" "$PY" -m ytk "$@"
